# Copy this file to ".env" and fill in your key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional overrides
LLM_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Login OTP email (Gmail SMTP) ----
# Gmail: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=SchemeFinder AI <yourname@gmail.com>

# If SMTP is NOT configured and this is true, the OTP is shown on screen (demo/testing only!)
DEV_SHOW_OTP=true
# Any long random string; used to hash OTPs
APP_SECRET=change-this-to-a-long-random-string
